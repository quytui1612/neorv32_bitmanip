/*
 * Magma (GOST R 34.12-2015) — two implementations comparing Bitmanip benefit.
 *
 * Magma round function:
 *   f(x) = ROL11( S(x) )
 * where S() applies 8 independent 4-bit S-boxes to each nibble of x.
 *
 * Implementation A: Pre-rotated tables (ROL11 absorbed, no rori)
 *   Tables pi87, pi65, pi43, pi21 from the original linux kernel driver.
 *   Each 32-bit entry = S(nibbles) already rotated left by 11.
 *   Bottleneck: pure RAM load latency, Zbb useless.
 *
 * Implementation B: Natural tables + explicit rori
 *   Tables store S(x) in bits[7:0] at natural position.
 *   After combining 4 table lookups: rori(result, 21) = ROL11.
 *   HOT PATH: 1 rori per round × 32 rounds = 32 rori/block.
 *   With Zbb: 32 × 22 cyc = 704 cyc from rori.
 *   W/o Zbb:  32 × 48 cyc = 1536 cyc from rot → +832 cyc overhead.
 */

#include <stdint.h>
#include <string.h>
#include "magma.h"

/* -----------------------------------------------------------------------
 * rev8 for big-endian load (Zbkb):
 *   With Zbkb: lw + rev8  = 2 instructions
 *   Without:   4 shift + 3 OR = 7 instructions
 * ---------------------------------------------------------------------- */
static inline uint32_t load_be32(const uint8_t *p)
{
#ifdef __riscv_zbkb
    uint32_t v;
    memcpy(&v, p, 4);
    __asm__ volatile("rev8 %0,%0" : "+r"(v));
    return v;
#else
    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
           ((uint32_t)p[2] <<  8) |  (uint32_t)p[3];
#endif
}

static inline void store_be32(uint8_t *p, uint32_t v)
{
#ifdef __riscv_zbkb
    __asm__ volatile("rev8 %0,%0" : "+r"(v));
    memcpy(p, &v, 4);
#else
    p[0] = v >> 24; p[1] = v >> 16; p[2] = v >> 8; p[3] = v;
#endif
}

/* -----------------------------------------------------------------------
 * Standard Magma S-boxes (8 nibble S-boxes, GOST R 34.12-2015 Magma).
 * sbox[i][j]: i = nibble position (0=MSN..7=LSN), j = 4-bit input value.
 * ---------------------------------------------------------------------- */
static const uint8_t sbox[8][16] = {
    { 12, 4, 6, 2, 10, 5, 11, 9, 14, 8, 13, 7, 0, 3, 15, 1 }, /* nibble 7 (bits 31:28) */
    {  6, 8, 2, 3,  9, 10, 5, 12, 1, 14,  4, 7, 11, 13,  0, 15 }, /* nibble 6 */
    { 11, 3, 5, 8, 2, 15, 10, 13, 14, 1,  7,  4, 12,  9,  6,  0 }, /* nibble 5 */
    { 12, 8, 2, 1, 13,  4, 15,  6,  7,  0, 10,  5,  3, 14,  9, 11 }, /* nibble 4 */
    {  7, 15, 5, 10, 8, 1, 6, 13,  0, 9,  3, 14, 11,  4,  2, 12 }, /* nibble 3 */
    {  5, 13, 15, 6,  9,  2,  12, 10, 11,  7,  8,  1,  4,  3, 14,  0 }, /* nibble 2 */
    {  8,  14, 2,  5,  6, 9, 1, 12, 15, 8,  3, 11,  0, 13, 10,  7 }, /* nibble 1 */
    {  1, 2, 4, 10, 9, 15, 3,  8, 11,  7, 14, 15,  2,  0,  7, 13 }, /* nibble 0 (bits 3:0) */
};

/* -----------------------------------------------------------------------
 * Pre-rotated lookup tables (ROL11 absorbed into table entries).
 * pi87[i]: S-boxes for nibbles 7 and 8 (bits 31:28, 27:24), result
 * placed at output bit positions already rotated left 11.
 * We re-derive them from sbox[] at init to avoid hard-coding errors.
 * ---------------------------------------------------------------------- */
static uint32_t prerot87[256]; /* nibbles 7(hi)  and  6  of input byte x>>24 */
static uint32_t prerot65[256]; /* nibbles 5 and 4 of input byte (x>>16)&0xff */
static uint32_t prerot43[256]; /* nibbles 3 and 2 of input byte (x>>8)&0xff  */
static uint32_t prerot21[256]; /* nibbles 1 and 0 of input byte x&0xff       */

/* Natural (un-rotated) tables: output in natural bit positions */
static uint32_t nat87[256];
static uint32_t nat65[256];
static uint32_t nat43[256];
static uint32_t nat21[256];

static int tables_ready = 0;

static inline uint32_t rol32(uint32_t x, unsigned n)
{
    return (x << n) | (x >> (32u - n));
}

static void build_tables(void)
{
    if (tables_ready) return;

    for (int i = 0; i < 256; i++) {
        /* Each byte covers 2 nibbles */
        int n_hi = (i >> 4) & 0xf;
        int n_lo =  i       & 0xf;

        /* Natural: S output in original nibble bit positions */
        uint32_t v87 = ((uint32_t)sbox[7][n_hi] << 28) | ((uint32_t)sbox[6][n_lo] << 24);
        uint32_t v65 = ((uint32_t)sbox[5][n_hi] << 20) | ((uint32_t)sbox[4][n_lo] << 16);
        uint32_t v43 = ((uint32_t)sbox[3][n_hi] << 12) | ((uint32_t)sbox[2][n_lo] <<  8);
        uint32_t v21 = ((uint32_t)sbox[1][n_hi] <<  4) | ((uint32_t)sbox[0][n_lo]      );

        nat87[i] = v87;
        nat65[i] = v65;
        nat43[i] = v43;
        nat21[i] = v21;

        /* Pre-rotated: absorb ROL11 into table */
        prerot87[i] = rol32(v87, 11);
        prerot65[i] = rol32(v65, 11);
        prerot43[i] = rol32(v43, 11);
        prerot21[i] = rol32(v21, 11);
    }
    tables_ready = 1;
}

/* -----------------------------------------------------------------------
 * Initialize context.
 * ---------------------------------------------------------------------- */
void magma_init(magma_ctx_t *ctx, const uint8_t key[32])
{
    build_tables();
    /* Magma key: 8 × 32-bit subkeys, big-endian */
    for (int i = 0; i < 8; i++)
        ctx->k[i] = load_be32(key + 4 * i);
}

/* -----------------------------------------------------------------------
 * [A] Pre-rotated: f(x) via pre-rotated tables, NO rori in hot path.
 * ---------------------------------------------------------------------- */
static inline uint32_t f_prerot(uint32_t x)
{
    return prerot87[x >> 24        ]
         | prerot65[(x >> 16) & 0xff]
         | prerot43[(x >>  8) & 0xff]
         | prerot21[ x        & 0xff];
}

void magma_encrypt_prerot(const magma_ctx_t *ctx,
                          const uint8_t in[8],
                                uint8_t out[8])
{
    uint32_t n1 = load_be32(in + 4);
    uint32_t n2 = load_be32(in);

    /* 3 rounds forward × 8 subkeys + 1 round reverse */
#define R_PRE(a, b, ki) (a) ^= f_prerot((b) + ctx->k[(ki)])
    R_PRE(n2,n1,0); R_PRE(n1,n2,1); R_PRE(n2,n1,2); R_PRE(n1,n2,3);
    R_PRE(n2,n1,4); R_PRE(n1,n2,5); R_PRE(n2,n1,6); R_PRE(n1,n2,7);
    R_PRE(n2,n1,0); R_PRE(n1,n2,1); R_PRE(n2,n1,2); R_PRE(n1,n2,3);
    R_PRE(n2,n1,4); R_PRE(n1,n2,5); R_PRE(n2,n1,6); R_PRE(n1,n2,7);
    R_PRE(n2,n1,0); R_PRE(n1,n2,1); R_PRE(n2,n1,2); R_PRE(n1,n2,3);
    R_PRE(n2,n1,4); R_PRE(n1,n2,5); R_PRE(n2,n1,6); R_PRE(n1,n2,7);
    /* Last 8 rounds: reverse key order */
    R_PRE(n2,n1,7); R_PRE(n1,n2,6); R_PRE(n2,n1,5); R_PRE(n1,n2,4);
    R_PRE(n2,n1,3); R_PRE(n1,n2,2); R_PRE(n2,n1,1); R_PRE(n1,n2,0);
#undef R_PRE

    store_be32(out,     n1);
    store_be32(out + 4, n2);
}

void magma_decrypt_prerot(const magma_ctx_t *ctx,
                          const uint8_t in[8],
                                uint8_t out[8])
{
    uint32_t n1 = load_be32(in + 4);
    uint32_t n2 = load_be32(in);

#define R_PRE(a, b, ki) (a) ^= f_prerot((b) + ctx->k[(ki)])
    /* Decrypt = reverse of encrypt key schedule */
    R_PRE(n2,n1,0); R_PRE(n1,n2,1); R_PRE(n2,n1,2); R_PRE(n1,n2,3);
    R_PRE(n2,n1,4); R_PRE(n1,n2,5); R_PRE(n2,n1,6); R_PRE(n1,n2,7);
    R_PRE(n2,n1,7); R_PRE(n1,n2,6); R_PRE(n2,n1,5); R_PRE(n1,n2,4);
    R_PRE(n2,n1,3); R_PRE(n1,n2,2); R_PRE(n2,n1,1); R_PRE(n1,n2,0);
    R_PRE(n2,n1,7); R_PRE(n1,n2,6); R_PRE(n2,n1,5); R_PRE(n1,n2,4);
    R_PRE(n2,n1,3); R_PRE(n1,n2,2); R_PRE(n2,n1,1); R_PRE(n1,n2,0);
    R_PRE(n2,n1,7); R_PRE(n1,n2,6); R_PRE(n2,n1,5); R_PRE(n1,n2,4);
    R_PRE(n2,n1,3); R_PRE(n1,n2,2); R_PRE(n2,n1,1); R_PRE(n1,n2,0);
#undef R_PRE

    store_be32(out,     n1);
    store_be32(out + 4, n2);
}

/* -----------------------------------------------------------------------
 * [B] Natural tables + explicit ROL11.
 * f(x) = ROL11( nat87[...] | nat65[...] | nat43[...] | nat21[...] )
 *
 * GCC+Zbb: ROL11 = rori rd, rs, 21    (1 instruction)
 * Without: ROL11 = srli+slli+or       (3 instructions + stalls ≈ 48 cycles)
 *
 * 32 rounds × 1 ROL11 = 32 rori per block.
 * ---------------------------------------------------------------------- */
static inline uint32_t f_natural(uint32_t x)
{
    uint32_t s = nat87[x >> 24        ]
               | nat65[(x >> 16) & 0xff]
               | nat43[(x >>  8) & 0xff]
               | nat21[ x        & 0xff];
    /* ROL11: GCC+Zbb emits rori rd, rs, 21 */
    return (s << 11) | (s >> 21);
}

void magma_encrypt_rori(const magma_ctx_t *ctx,
                        const uint8_t in[8],
                              uint8_t out[8])
{
    uint32_t n1 = load_be32(in + 4);
    uint32_t n2 = load_be32(in);

#define R_NAT(a, b, ki) (a) ^= f_natural((b) + ctx->k[(ki)])
    R_NAT(n2,n1,0); R_NAT(n1,n2,1); R_NAT(n2,n1,2); R_NAT(n1,n2,3);
    R_NAT(n2,n1,4); R_NAT(n1,n2,5); R_NAT(n2,n1,6); R_NAT(n1,n2,7);
    R_NAT(n2,n1,0); R_NAT(n1,n2,1); R_NAT(n2,n1,2); R_NAT(n1,n2,3);
    R_NAT(n2,n1,4); R_NAT(n1,n2,5); R_NAT(n2,n1,6); R_NAT(n1,n2,7);
    R_NAT(n2,n1,0); R_NAT(n1,n2,1); R_NAT(n2,n1,2); R_NAT(n1,n2,3);
    R_NAT(n2,n1,4); R_NAT(n1,n2,5); R_NAT(n2,n1,6); R_NAT(n1,n2,7);
    R_NAT(n2,n1,7); R_NAT(n1,n2,6); R_NAT(n2,n1,5); R_NAT(n1,n2,4);
    R_NAT(n2,n1,3); R_NAT(n1,n2,2); R_NAT(n2,n1,1); R_NAT(n1,n2,0);
#undef R_NAT

    store_be32(out,     n1);
    store_be32(out + 4, n2);
}

/* -----------------------------------------------------------------------
 * Benchmark wrappers: key[16] used as first 16 bytes, padded with 0.
 * ---------------------------------------------------------------------- */
void magma_bench_prerot(const uint8_t key[16], const uint8_t in[16], uint8_t out[16])
{
    static magma_ctx_t ctx;
    static uint8_t last_key[16];
    static int init = 0;
    if (!init || memcmp(key, last_key, 16)) {
        uint8_t k32[32];
        memcpy(k32,      key, 16);
        memcpy(k32 + 16, key, 16); /* double key to fill 256 bits */
        magma_init(&ctx, k32);
        memcpy(last_key, key, 16);
        init = 1;
    }
    uint8_t tmp[8];
    magma_encrypt_prerot(&ctx, in, tmp);
    memcpy(out, tmp, 8);
    memcpy(out + 8, tmp, 8);
}

void magma_bench_rori(const uint8_t key[16], const uint8_t in[16], uint8_t out[16])
{
    static magma_ctx_t ctx;
    static uint8_t last_key[16];
    static int init = 0;
    if (!init || memcmp(key, last_key, 16)) {
        uint8_t k32[32];
        memcpy(k32,      key, 16);
        memcpy(k32 + 16, key, 16);
        magma_init(&ctx, k32);
        memcpy(last_key, key, 16);
        init = 1;
    }
    uint8_t tmp[8];
    magma_encrypt_rori(&ctx, in, tmp);
    memcpy(out, tmp, 8);
    memcpy(out + 8, tmp, 8);
}
